{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "cache": "localhost:6379"
  },
  "WeatherCache": {
    "ExpirationTimeoutMinutes": 60
  },
  "ApiKeys": {
    "OpenWeatherMapApiKey": "apiKeyValue"
  },
  "OpenWeatherMap": {
    "BaseUrl": "https://api.openweathermap.org"
  },
  "OpenMeteo": {
    "BaseUrl": "https://api.open-meteo.com"
  }
}
