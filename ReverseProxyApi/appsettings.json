{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
      
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "weather-api": {
            "Address": "http://localhost:5009"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      }
    }
  }
}
